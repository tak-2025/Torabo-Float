{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist/"
  },
  "productName": "Torabo Float",
  "mainBinaryName": "torabo-float",
  "version": "0.1.0",
  "identifier": "io.github.tak-2025.torabo-float",
  "bundle": {
    "active": true,
    "category": "Utility",
    "copyright": "",
    "externalBin": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "longDescription": "",
    "resources": [],
    "shortDescription": "",
    "targets": "all",
    "windows": {}
  },
  "app": {
    "security": {
      "capabilities": [
        "default"
      ],
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost"
      }
    },
    "windows": [
      {
        "label": "main",
        "title": "Torabo Float",
        "width": 560,
        "height": 320,
        "resizable": true,
        "fullscreen": false,
        "transparent": true,
        "alwaysOnTop": true,
        "decorations": false,
        "skipTaskbar": true
      }
    ]
  }
}
